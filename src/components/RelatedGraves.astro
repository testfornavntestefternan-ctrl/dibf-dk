---
import { graves } from '../data/site';

interface Props {
  exclude?: string;
}

const { exclude } = Astro.props;
const items = graves.filter((g) => g.slug !== exclude);
---

<div class="related">
  {
    items.map((grave) => (
      <a class="grave-card" href={grave.href} data-accent={grave.accent} data-tilt>
        <div class="grave-card__media">
          <img src={grave.image} alt="" width="640" height="480" loading="lazy" />
        </div>
        <div class="grave-card__body">
          <p class="grave-card__kicker">{grave.kicker}</p>
          <h3>{grave.title}</h3>
          <p>{grave.excerpt}</p>
        </div>
      </a>
    ))
  }
</div>
