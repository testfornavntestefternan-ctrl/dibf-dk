---
import { ClientRouter } from 'astro:transitions';
import { contact, nav, site, withBase } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath: string;
}

const { title, description = site.description, currentPath } = Astro.props;
const pageTitle = title === site.name ? `${site.fullName}` : `${title} – ${site.name}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0e1a" />
    <meta name="view-transition" content="same-origin" />
    <link rel="icon" href={withBase('/images/favicon.png')} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Inter:opsz,wght@14..32,400..700&family=Noto+Naskh+Arabic:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('dibf-theme');
          document.documentElement.dataset.theme = stored || 'dark';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
        try {
          var loc = localStorage.getItem('dibf-locale');
          if (loc === 'en' || loc === 'ar' || loc === 'da') {
            document.documentElement.lang = loc;
            document.documentElement.dir = loc === 'ar' ? 'rtl' : 'ltr';
            document.documentElement.dataset.locale = loc;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content" data-i18n="nav.skip">Spring til indhold</a>
    <div class="aurora" aria-hidden="true">
      <div class="aurora__blob aurora__blob--a"></div>
      <div class="aurora__blob aurora__blob--b"></div>
      <div class="aurora__blob aurora__blob--c"></div>
    </div>
    <canvas class="stars" id="starfield" aria-hidden="true"></canvas>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={withBase('/')} data-astro-prefetch>
          <img src={withBase('/images/logo-badge.png')} alt="DIBF-logo" width="48" height="48" />
          <span class="brand__text">
            <span class="brand__name">{site.name}</span>
            <span class="brand__sub" data-i18n="brand.sub">Gravplads Brøndby</span>
          </span>
        </a>

        <nav class="nav" aria-label="Hovednavigation">
          {
            nav.map((item) => (
              <a
                href={withBase(item.href)}
                aria-current={currentPath === item.href ? 'page' : undefined}
                data-astro-prefetch
                data-i18n={item.i18n}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="header-actions">
          <div class="lang-switch" role="group" data-i18n-aria="nav.lang" aria-label="Sprog">
            <button type="button" data-locale="da">DA</button>
            <button type="button" data-locale="en">EN</button>
            <button type="button" data-locale="ar">AR</button>
          </div>
          <button class="icon-btn" type="button" data-theme-toggle aria-pressed="false" data-i18n-aria="theme.toLight" aria-label="Skift tema">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3a9 9 0 1 0 9 9c0-.5-.04-1-.12-1.48A7 7 0 0 1 12 3Z" stroke="currentColor" stroke-width="1.7" />
            </svg>
          </button>
          <button
            class="icon-btn menu-toggle"
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-i18n-aria="nav.menu"
            aria-label="Åbn menu"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>
      <div class="wrap drawer" id="mobile-nav" data-drawer data-open="false">
        {
          nav.map((item) => (
            <a href={withBase(item.href)} aria-current={currentPath === item.href ? 'page' : undefined} data-i18n={item.i18n}>
              {item.label}
            </a>
          ))
        }
      </div>
    </header>

    <main id="content" class="page wrap" transition:animate="fade">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div>
          <h2 data-i18n="footer.address">Adresse</h2>
          <p>
            {contact.address[0]}<br />
            {contact.address[1]}<br />
            <a href={contact.phoneHref}>{contact.phone}</a>
          </p>
        </div>
        <div>
          <h2 data-i18n="footer.contact">Kontakt</h2>
          <p>
            <a href={`mailto:${contact.emails.bestyrelse}`}>{contact.emails.bestyrelse}</a><br />
            <a href={`mailto:${contact.emails.drift}`}>{contact.emails.drift}</a><br />
            CVR {contact.cvr}
          </p>
        </div>
        <div>
          <h2 data-i18n="footer.hours">Åbningstider</h2>
          <p>
            <span data-i18n="footer.office">Kontor</span>: {contact.hours}<br />
            {site.fullName}
          </p>
        </div>
      </div>
      <div class="wrap legal">
        <span>© {new Date().getFullYear()} {site.fullName}</span>
        <a href={withBase('/om-os')} data-i18n="footer.about">Om fonden</a>
      </div>
    </footer>

    <a class="icon-btn to-top" href="#content" data-to-top data-i18n-aria="footer.top" aria-label="Til toppen">↑</a>

    <script>
      import { boot, initLightbox } from '../scripts/ui';
      import { initI18n } from '../scripts/i18n';
      import { initCms } from '../scripts/cms';
      const start = () => {
        boot();
        initI18n();
        initCms();
        initLightbox();
      };
      start();
      document.addEventListener('astro:page-load', start);
    </script>
  </body>
</html>
