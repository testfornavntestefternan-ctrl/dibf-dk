---
import Base from '../layouts/Base.astro';
import { contact, graves, prices } from '../data/site';

const totals = prices.rows[prices.rows.length - 1];
---

<Base
  title="Ved dødsfald"
  description="Hvad pårørende skal gøre ved et dødsfald, gravtyper, priser og DIBS-medlemskab på DIBF-gravpladsen."
  currentPath="/ved-dodsfald"
>
  <header class="page-hero">
    <p class="kicker">Pårørende</p>
    <h1>Ved dødsfald</h1>
    <p class="lede">Når et dødsfald sker, er der nogle få trin, I skal huske. Bedemanden kan tage resten.</p>
  </header>

  <div class="split">
    <article class="stack-lg prose">
      <section class="glass" style="padding: 1.5rem" id="trin">
        <h2>Ved et dødsfald skal I</h2>
        <ol>
          <li>Kontakte alarmcentralen på <a href="tel:112">112</a>, hvis det er akut.</li>
          <li>Afvente at hospital eller læge har konstateret dødsfaldet og skrevet attest.</li>
          <li>Tage kontakt til en bedemand. Bedemanden sørger for hele begravelsen.</li>
        </ol>
      </section>

      <section class="glass" style="padding: 1.5rem" id="dibs">
        <h2>Medlem af DIBS?</h2>
        <p>
          Hvis den afdøde er medlem af DIBS (støtteforeningen), skal I oplyse bedemanden om det. DIBS betaler begravelsesomkostningerne, og bedemanden skal kontakte støtteforeningen.
        </p>
        <p>
          Indmeldelse sker via <a href="https://mitdibf.dk/" rel="noreferrer">mitdibf.dk</a>.
        </p>
      </section>

      <section class="glass" style="padding: 1.5rem" id="uden-kiste">
        <h2>Begravelse uden kiste</h2>
        <p>Kontakt gravpladsen og bedemanden for den konkrete procedure. Der kan være særlige krav til svøb, transport og gravning.</p>
      </section>

      <section class="glass" style="padding: 1.5rem" id="efter-to-aar">
        <h2>Gravsted efter 2 år</h2>
        <p>
          Gravpladsen sætter kantsten tidligst to år efter begravelsen. Gravstenen sættes af gravstedsejeren via stenhugger og skal overholde målene under gravtyperne. Se også <a href="/gravspladsen">ordensregler for gravpladsen</a>.
        </p>
      </section>
    </article>

    <aside class="stack">
      <nav class="toc" aria-label="Indhold">
        <h2>Indhold</h2>
        <a href="#trin">Ved et dødsfald</a>
        <a href="#dibs">DIBS-medlemskab</a>
        <a href="#gravtyper">Gravtyper</a>
        <a href="#priser">Priser</a>
        <a href="#faq">Spørgsmål og svar</a>
      </nav>
      <a class="btn btn--primary" href="/for-bedemaend">Fuld prisliste til bedemænd</a>
      <a class="btn btn--ghost" href="/kontakt">Kontakt os</a>
    </aside>
  </div>

  <section class="stack-lg" style="margin-block-start: 3rem" id="gravtyper">
    <div class="section-head">
      <p class="kicker">Grave</p>
      <h2>Tre gravtyper</h2>
      <p class="muted">Priser er for {prices.year} og inkluderer moms, hvor det er angivet.</p>
    </div>
    <div class="grave-grid">
      {
        graves.map((grave) => (
          <a class="grave-card" href={`#${grave.slug}`} data-accent={grave.accent} data-tilt>
            <div class="grave-card__media">
              <img src={grave.image} alt="" width="800" height="600" />
            </div>
            <div class="grave-card__body">
              <p class="grave-card__kicker">{grave.kicker}</p>
              <h3>{grave.title}</h3>
              <p>{grave.excerpt}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <article class="split" style="margin-block-start: 3rem" id="voksne">
    <div class="stack">
      <img class="glass" src="/images/voksne.jpg" alt="Voksengrav på gravpladsen" width="1000" height="750" />
      <div class="prose glass" style="padding: 1.5rem">
        <h2>Voksengrav</h2>
        <p>
          En voksengrav har 30 års fredning. Prisen i {prices.year} er 25.000 kr. inkl. moms og dækker gravsted, gravning og dækning, administration samt kantsten, der sættes efter mindst to år.
        </p>
        <p>
          Gravstenen sættes af gravstedsejeren via stenhugger. Mål: max. 40 cm højde × 58 cm bredde. Stenen skal være en liggesten med hævet bagkant, anbragt nedlagt i græs i gravens midterlinje.
        </p>
        <p>
          Weekend- og helligdagstillæg er 4.000 kr. Bestilling sker via bedemand.
        </p>
      </div>
    </div>
    <aside class="toc">
      <h2>Nøgletal</h2>
      <p>Fredning: 30 år</p>
      <p>Samlet pris: 25.000 kr.</p>
      <p>Kantsten: efter 2 år</p>
      <p>Gravsten: max. 40 × 58 cm</p>
    </aside>
  </article>

  <article class="split" style="margin-block-start: 3rem" id="born">
    <div class="stack">
      <img class="glass" src="/images/born.jpg" alt="Børnegrav på gravpladsen" width="1280" height="960" />
      <div class="prose glass" style="padding: 1.5rem">
        <h2>Børnegrav</h2>
        <p>
          En børnegrav gælder kister på højst 1 meter. Fredningen er 30 år. Samlet pris i {prices.year} er 12.750 kr. inkl. moms og dækker gravsted, gravning og dækning, administration samt kantsten efter mindst to år.
        </p>
        <p>Gravsten: max. 30 × 30 cm. Trækantsten koster 500 kr. Weekend- og helligdagstillæg er 2.000 kr.</p>
      </div>
    </div>
    <aside class="toc">
      <h2>Nøgletal</h2>
      <p>Længde: max. 1 m</p>
      <p>Fredning: 30 år</p>
      <p>Samlet pris: 12.750 kr.</p>
      <p>Gravsten: max. 30 × 30 cm</p>
    </aside>
  </article>

  <article class="split" style="margin-block-start: 3rem" id="fostre">
    <div class="stack">
      <img class="glass" src="/images/fostre.jpg" alt="Fostergrav på gravpladsen" width="1280" height="960" />
      <div class="prose glass" style="padding: 1.5rem">
        <h2>Fostergrav</h2>
        <p>
          Fostergrave har 5 års fredning. Den samlede pris i {prices.year} er 5.750 kr. inkl. moms og dækker gravsted, gravning og dækning samt administration. Der sættes ikke kantsten, og gravsten er ikke en del af standardydelsen.
        </p>
        <p>Weekend- og helligdagstillæg er 1.000 kr. Bestilling skal ske mindst 6 timer før, og begravelsen afventer skriftlig bekræftelse.</p>
      </div>
    </div>
    <aside class="toc">
      <h2>Nøgletal</h2>
      <p>Fredning: 5 år</p>
      <p>Samlet pris: 5.750 kr.</p>
      <p>Kantsten: 0 kr.</p>
      <p>Tillæg weekend: 1.000 kr.</p>
    </aside>
  </article>

  <section style="margin-block-start: 3rem" id="priser">
    <div class="section-head">
      <p class="kicker">Priser {prices.year}</p>
      <h2>Samlet beløb</h2>
      <p class="muted">Det I betaler i alt, inkl. moms. Den fulde opdeling ligger hos bedemændene.</p>
    </div>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>Ydelse</th>
            <th>Voksen</th>
            <th>Barn (max 1 m)</th>
            <th>Foster</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>{totals.label}</td>
            <td>{totals.adult}</td>
            <td>{totals.child}</td>
            <td>{totals.fetus}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="muted" style="margin-block-start: 0.8rem">
      {prices.extra} <a href="/for-bedemaend">Se fuld prisliste</a>.
    </p>
  </section>

  <section class="stack" style="margin-block-start: 3rem" id="faq">
    <h2>Spørgsmål og svar</h2>
    <details class="glass" style="padding: 1.1rem 1.3rem">
      <summary><strong>Hvordan ordner jeg selv en begravelse?</strong></summary>
      <p>
        Lægen skriver dødsattest. Derefter anmoder du om begravelse via borger.dk. Sognet kan først godkende, når dato og tid er fastsat. Bestil gravpladsen hos os på {contact.phone} senest kl. 12:00 hverdagen før. Du må selv transportere afdøde, eller en bedemand kan gøre det. Begravelseshjælp søges på borger.dk.
      </p>
    </details>
    <details class="glass" style="padding: 1.1rem 1.3rem">
      <summary><strong>Hvad betaler jeg for?</strong></summary>
      <p>
        Prisen dækker gravning, fredning i 30 år (5 år for foster) og renholdelse af fællesarealer. Fredning kan forlænges senere. Se <a href="/for-bedemaend">den fulde prisliste</a>.
      </p>
    </details>
    <details class="glass" style="padding: 1.1rem 1.3rem">
      <summary><strong>Hvordan bliver jeg medlem af DIBS?</strong></summary>
      <p>
        Udfyld og underskriv indmeldelsesblanketten hos <a href="https://mitdibf.dk/" rel="noreferrer">Dansk Islamisk Begravelsesfonds støtteforening</a>.
      </p>
    </details>
  </section>
</Base>
