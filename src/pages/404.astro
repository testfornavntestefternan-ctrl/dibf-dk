---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../data/site';
---

<Base title="Siden findes ikke" currentPath="">
  <header class="page-hero">
    <p class="kicker">404</p>
    <h1 data-i18n="notfound.h1">Siden findes ikke.</h1>
    <p class="lede" data-i18n="notfound.lede">Gå tilbage til forsiden, eller brug menuen.</p>
    <div class="cta-row">
      <a class="btn btn--primary" href={withBase('/')}>
        <Icon name="home" size={18} />
        <span data-i18n="notfound.home">Til forsiden</span>
      </a>
      <a class="btn btn--ghost" href={withBase('/kontakt')} data-i18n="nav.contact">Kontakt</a>
    </div>
  </header>
</Base>
