---
import Base from '../layouts/Base.astro';
import { withBase } from '../data/site';
---

<Base title="Siden findes ikke" currentPath="">
  <header class="page-hero">
    <p class="kicker">404</p>
    <h1>Vi fandt ikke siden.</h1>
    <p class="lede">Gå tilbage til forsiden, eller brug menuen til at finde gravpladsen, vejledning og kontakt.</p>
    <div class="cta-row">
      <a class="btn btn--primary" href={withBase('/')}>Til forsiden</a>
      <a class="btn btn--ghost" href={withBase('/kontakt')}>Kontakt os</a>
    </div>
  </header>
</Base>
