---
import Base from '../../layouts/Base.astro';
import RelatedGraves from '../../components/RelatedGraves.astro';
---

<Base title="Voksne grav" description="Voksengrav på DIBF-gravpladsen: 30 års fredning, gravsten, kantsten og priser." currentPath="/grav/voksne">
  <header class="page-hero">
    <p class="kicker">Fredning 30 år</p>
    <h1>Voksne grav</h1>
    <p class="lede">Den almindelige gravtype for voksne. Fredning, sten og vedligeholdelse følger gravpladsens regler.</p>
  </header>

  <article class="split">
    <div class="stack">
      <img class="glass" src="/images/voksne.jpg" alt="Voksengrav på gravpladsen" width="1000" height="750" />
      <div class="prose glass" style="padding: 1.5rem">
        <p>
          En voksengrav på den muslimske gravplads i Brøndby har 30 års fredning. Prisen i 2024 er 25.000 kr. inkl. moms og dækker gravsted, gravning og dækning, administration samt kantsten, der sættes efter mindst to år.
        </p>
        <p>
          Gravstenen sættes af gravstedsejeren via stenhugger. Mål: max. 40 cm højde × 58 cm bredde. Stenen skal være en liggesten med hævet bagkant, anbragt nedlagt i græs i gravens midterlinje.
        </p>
        <p>
          Små potter og blomsterbakker er tilladt. Store planter, træer, billeder, stearinlys, mad og bamser må ikke sættes på graven. Den enkelte grav vedligeholdes af gravstedsejeren.
        </p>
        <p>
          Weekend- og helligdagstillæg er 4.000 kr. Bestilling sker via bedemand eller <a href="/for-bedemaend">for bedemænd</a>.
        </p>
      </div>
    </div>
    <aside class="stack">
      <div class="toc">
        <h2>Nøgletal</h2>
        <p>Fredning: 30 år</p>
        <p>Samlet pris: 25.000 kr.</p>
        <p>Kantsten: efter 2 år</p>
        <p>Gravsten: max. 40 × 58 cm</p>
      </div>
      <a class="btn btn--primary" href="/for-bedemaend">Se fuld prisliste</a>
    </aside>
  </article>

  <section style="margin-block-start: 3rem">
    <h2 class="section-head">Andre gravtyper</h2>
    <RelatedGraves exclude="voksne" />
  </section>
</Base>
