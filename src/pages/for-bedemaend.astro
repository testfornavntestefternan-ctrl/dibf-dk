---
import Base from '../layouts/Base.astro';
import { contact, prices, withBase } from '../data/site';
---

<Base title="For bedemænd" description="Bestilling, prisliste og bedemandens opgaver ved begravelse på DIBF-gravpladsen." currentPath="/for-bedemaend">
  <header class="page-hero">
    <p class="kicker" data-i18n="und.kicker">Professionelle</p>
    <h1 data-i18n="und.title">For bedemænd</h1>
    <p class="lede">
      <span data-i18n="und.lede">Bestilling, priser og ansvarsfordeling. Begravelse finder først sted, når I har modtaget bekræftelse. Er I pårørende? Se ved dødsfald.</span>
      {' '}
      <a href={withBase('/ved-dodsfald')} data-i18n="nav.death">Ved dødsfald</a>
    </p>
  </header>

  <div class="stack-lg">
    <section class="glass" style="padding: 1.5rem">
      <h2 data-i18n="und.order">Bestilling</h2>
      <ul>
        <li>
          <span data-i18n="und.o1">Udfyld bestillingsseddel og send den til</span>
          {' '}
          <a href={`mailto:${contact.emails.bestilling}`}>{contact.emails.bestilling}</a>.
        </li>
        <li data-i18n="und.o2">Begravelse finder ikke sted, før I modtager bekræftelse.</li>
        <li data-i18n="und.o3">Bestilling skal ske mindst 6 timer før begravelsen.</li>
        <li>
          <span data-i18n="und.o4">Ring også til kontoret på</span>
          {' '}
          <a href={contact.phoneHref}>{contact.phone}</a> ({contact.hours}).
        </li>
      </ul>
    </section>

    <section>
      <div class="section-head">
        <p class="kicker" data-i18n="und.priceKicker">Priser {prices.year}</p>
        <h2 data-i18n="und.priceTitle">Prisliste for begravelse</h2>
      </div>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th data-i18n="price.service">Ydelse</th>
              <th data-i18n="price.adult">Voksen</th>
              <th data-i18n="price.child">Barn (max 1 m)</th>
              <th data-i18n="price.fetus">Foster</th>
            </tr>
          </thead>
          <tbody>
            {
              prices.rows.map((row) => (
                <tr>
                  <td data-i18n={row.i18n}>{row.label}</td>
                  <td>{row.adult}</td>
                  <td>{row.child}</td>
                  <td>{row.fetus}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="muted" style="margin-block-start: 0.8rem" data-i18n="price.extra">{prices.extra}</p>
    </section>

    <section class="split">
      <div class="glass" style="padding: 1.5rem">
        <h2 data-i18n="und.tasks">Bedemandens opgaver</h2>
        <ul>
          <li data-i18n="und.t1">Kontakt til hospitalet ved afhentning af den afdøde</li>
          <li data-i18n="und.t2">Godkendelse og aflevering af dokumenter til hospital, gravplads og kommune</li>
          <li data-i18n="und.t3">Fremskaffelse af kiste og ligklæder</li>
          <li data-i18n="und.t4">Bestilling af gravplads</li>
          <li data-i18n="und.t5">Transport af kisten til moskeen</li>
          <li data-i18n="und.t6">Transport af kisten fra moskeen til gravpladsen</li>
          <li data-i18n="und.t7">Økonomi i forhold til bedemand, kommune og gravplads</li>
        </ul>
      </div>
      <div class="glass" style="padding: 1.5rem">
        <h2 data-i18n="und.family">Familien står selv for</h2>
        <ul>
          <li data-i18n="und.f1">Afvaskning af den afdøde (i samarbejde med bedemanden)</li>
          <li data-i18n="und.f2">Aftale med moskeen om begravelsesbøn, Salat-ul Janazah</li>
        </ul>
        <p class="muted" data-i18n="und.note">Gravpladsen er ikke praktisk involveret i forbindelse med et dødsfald ud over gravning, gravsted og administration.</p>
      </div>
    </section>
  </div>
</Base>
