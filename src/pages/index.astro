---
import Base from '../layouts/Base.astro';
import { contact, paths, site, withBase } from '../data/site';
---

<Base title={site.name} currentPath="/">
  <section class="hero reveal">
    <div class="stack">
      <p class="kicker" data-i18n="home.kicker">Dansk Islamisk Begravelsesfond</p>
      <h1 data-i18n="home.heroTitle">Et sted for værdighed, ro og fællesskab.</h1>
      <p class="lede" data-i18n="home.tagline">{site.tagline}</p>
      <div class="cta-row">
        <a class="btn btn--primary" href={withBase('/ved-dodsfald')} data-i18n="home.ctaDeath">Ved dødsfald</a>
        <a class="btn btn--ghost" href={withBase('/kontakt')} data-i18n="home.ctaContact">Kontakt os</a>
      </div>
    </div>
    <a class="hero-panel" href={withBase('/gravspladsen')} data-astro-prefetch>
      <img src={withBase('/images/port.jpg')} alt="Indgangen til den muslimske gravplads i Brøndby" width="1200" height="900" data-i18n-alt="home.heroAlt" />
      <span class="hero-panel__meta">
        <span class="kicker" data-i18n="path.visit.kicker">Besøg</span>
        <strong data-i18n="home.heroPlace">Brøndbyøstervej 180</strong>
        <span data-i18n="home.heroCaption">Danmarks første muslimske gravplads uden tilknytning til en kristen kirkegård. Indviet 22. september 2006.</span>
        <span class="hero-panel__cta" data-i18n="home.heroCta">Se gravpladsen</span>
      </span>
    </a>
  </section>

  <section class="facts reveal" data-i18n-aria="home.factsLabel" aria-label="Nøgletal">
    <div class="fact">
      <strong>50.000 m²</strong>
      <span class="muted" data-i18n="home.factArea">Samlet areal i den grønne kile ved Brøndby</span>
    </div>
    <div class="fact">
      <strong>6–8.000</strong>
      <span class="muted" data-i18n="home.factGraves">Grave — kapacitet årtier frem</span>
    </div>
    <div class="fact">
      <strong>08–12</strong>
      <span class="muted" data-i18n="home.factHours">Kontor mandag til fredag</span>
    </div>
  </section>

  <section class="stack-lg" style="margin-block-start: 3.5rem">
    <div class="section-head">
      <p class="kicker" data-i18n="home.newsKicker">Nyt</p>
      <h2 data-i18n="home.newsTitle">Nyheder</h2>
    </div>
    <div class="news-grid" data-cms-news>
      <p class="muted" data-cms-news-empty data-i18n="home.newsEmpty">Der er ingen nyheder endnu.</p>
    </div>
  </section>

  <section class="stack-lg" style="margin-block-start: 3.5rem">
    <div class="section-head">
      <p class="kicker" data-i18n="home.findKicker">Find videre</p>
      <h2 data-i18n="home.findTitle">Hvad skal du?</h2>
    </div>
    <div class="path-grid">
      {
        paths.map((item) => (
          <a class="path-card" href={item.href} data-accent={item.accent} data-tilt>
            <p class="grave-card__kicker" data-i18n={`${item.i18n}.kicker`}>{item.kicker}</p>
            <h3 data-i18n={`${item.i18n}.title`}>{item.title}</h3>
            <p data-i18n={`${item.i18n}.text`}>{item.text}</p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
