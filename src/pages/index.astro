---
import Base from '../layouts/Base.astro';
import { contact, paths, site, withBase } from '../data/site';
---

<Base title={site.name} currentPath="/">
  <section class="hero reveal">
    <div class="stack">
      <p class="kicker">Dansk Islamisk Begravelsesfond</p>
      <h1>Et sted for værdighed, ro og fællesskab.</h1>
      <p class="lede">{site.tagline}</p>
      <div class="cta-row">
        <a class="btn btn--primary" href={withBase('/ved-dodsfald')}>Ved dødsfald</a>
        <a class="btn btn--ghost" href={withBase('/kontakt')}>Kontakt os</a>
      </div>
    </div>
    <figure class="hero-panel">
      <img src={withBase('/images/port.jpg')} alt="Indgangen til den muslimske gravplads i Brøndby" width="1200" height="900" />
      <figcaption class="hero-panel__meta">
        <strong>Brøndbyøstervej 180</strong>
        <p class="muted">Danmarks første muslimske gravplads uden tilknytning til en kristen kirkegård. Indviet 22. september 2006.</p>
      </figcaption>
    </figure>
  </section>

  <section class="facts reveal" aria-label="Nøgletal">
    <div class="fact">
      <strong>50.000 m²</strong>
      <span class="muted">Samlet areal i den grønne kile ved Brøndby</span>
    </div>
    <div class="fact">
      <strong>6–8.000</strong>
      <span class="muted">Grave — kapacitet årtier frem</span>
    </div>
    <div class="fact">
      <strong>08–12</strong>
      <span class="muted">Kontor mandag til fredag · {contact.phone}</span>
    </div>
  </section>

  <section class="stack-lg" style="margin-block-start: 3.5rem">
    <div class="section-head">
      <p class="kicker">Find videre</p>
      <h2>Hvad skal du?</h2>
    </div>
    <div class="path-grid">
      {
        paths.map((item) => (
          <a class="path-card" href={item.href} data-accent={item.accent} data-tilt>
            <p class="grave-card__kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
