---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Ornament from '../../components/Ornament.astro';
import { board, contact } from '../../data/site';
---

<Base title="Bestyrelse" description="Bestyrelsen for Dansk Islamisk Begravelsesfondens Støtteforening." currentPath="/bestyrelse">
  <header class="page-hero">
    <p class="kicker" data-i18n="board.kicker">Ledelse</p>
    <h1 data-i18n="board.title">Bestyrelse</h1>
    <Ornament />
    <p class="lede" data-i18n="board.year">Bestyrelsen som offentliggjort på mitdibf.dk (2022).</p>
  </header>

  <div class="board-grid">
    {
      board.map((member) => (
        <article class="board-card">
          <span class="icon-badge">
            <Icon name="crescent" />
          </span>
          <h2>{member.name}</h2>
          <p class="muted" data-i18n={member.roleKey}>
            {member.role}
          </p>
        </article>
      ))
    }
  </div>

  <p style="margin-block-start: 1.5rem">
    <a class="btn btn--ghost" href={`mailto:${contact.emails.bestyrelse}`}>
      <Icon name="envelope" size={18} />
      <span data-i18n="board.email">E-mail</span>
      <span>{contact.emails.bestyrelse}</span>
    </a>
  </p>
</Base>
