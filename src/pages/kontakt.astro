---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import { contact } from '../data/site';

const inboxes = [
  { key: 'contact.member', label: 'Medlemskab', email: contact.emails.medlem, icon: 'family' as const },
  { key: 'contact.info', label: 'Klager og generel info', email: contact.emails.info, icon: 'envelope' as const },
  { key: 'contact.finance', label: 'Finans', email: contact.emails.finans, icon: 'coin' as const },
  { key: 'contact.board', label: 'Bestyrelse', email: contact.emails.bestyrelse, icon: 'board' as const },
];
---

<Base title="Kontakt" description="Kontakt DIBS — medlemskab, klager, finans og bestyrelse." currentPath="/kontakt">
  <header class="page-hero">
    <p class="kicker" data-i18n="contact.kicker">Vi svarer</p>
    <h1 data-i18n="contact.title">Kontakt</h1>
    <Ornament />
    <p class="lede" data-i18n="contact.lede">Skriv til den rigtige indbakke — så lander sagen det rigtige sted.</p>
  </header>

  <div class="contact-layout">
    <div class="stack">
      <div class="contact-grid">
        {
          inboxes.map((item) => (
            <a class="contact-card" href={`mailto:${item.email}`}>
              <span class="icon-badge">
                <Icon name={item.icon} />
              </span>
              <p class="kicker" data-i18n={item.key}>
                {item.label}
              </p>
              <strong>{item.email}</strong>
            </a>
          ))
        }
      </div>

      <section class="contact-card">
        <span class="icon-badge"><Icon name="home" /></span>
        <h2 data-i18n="contact.address">Adresse</h2>
        <p>
          {contact.address[0]}<br />
          {contact.address[1]}<br />
          CVR {contact.cvr}<br />
          {contact.web}
        </p>
      </section>
    </div>

    <form class="contact-form glass" action={`mailto:${contact.emails.medlem}`} method="get">
      <h2 data-i18n="contact.write">Skriv til os</h2>
      <p class="muted" data-i18n="contact.writeLede">Formularen åbner din e-mail. Intet sendes til en server.</p>
      <div class="contact-form__row">
        <label>
          <span data-i18n="contact.name">Navn</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          <span data-i18n="contact.inbox">Indbakke</span>
          <select name="to">
            {inboxes.map((item) => <option value={item.email}>{item.email}</option>)}
          </select>
        </label>
      </div>
      <label>
        <span data-i18n="contact.subject">Emne</span>
        <input type="text" name="subject" required />
      </label>
      <label>
        <span data-i18n="contact.message">Besked</span>
        <textarea name="body" required></textarea>
      </label>
      <button class="btn btn--primary" type="submit">
        <Icon name="envelope" size={18} />
        <span data-i18n="contact.submit">Åbn e-mail</span>
      </button>
    </form>
  </div>
</Base>
