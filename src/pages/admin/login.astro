---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../data/site';
---

<Base title="Log ind" description="Log ind for at lægge meddelelser på DIBS-sitet." currentPath="/admin/login">
  <header class="page-hero">
    <p class="kicker">DIBS</p>
    <h1 data-i18n="cms.loginTitle">Bestyrelsens adgang</h1>
    <p class="lede" data-i18n="cms.loginLede">Log ind for at lægge meddelelser på forsiden.</p>
  </header>

  <form class="cms-login glass" data-cms-login data-next={withBase('/admin/')}>
    <label>
      <span data-i18n="cms.user">Brugernavn</span>
      <input type="text" name="username" autocomplete="username" required />
    </label>
    <label>
      <span data-i18n="cms.pass">Adgangskode</span>
      <input type="password" name="password" autocomplete="current-password" required />
    </label>
    <p class="cms-error" data-cms-error data-i18n="cms.error" hidden>Forkert brugernavn eller adgangskode.</p>
    <p class="muted" data-i18n="cms.hint">Ændringer gemmes i denne browser.</p>
    <button class="btn btn--primary" type="submit" data-i18n="cms.login">Log ind</button>
  </form>
</Base>
